# Copiez ce fichier en .env (ou exportez ces variables) : toutes sont facultatives.

# Moteur affiché au démarrage : ollama (local, gratuit) ou claude (API Anthropic)
DATAMIND_ENGINE=ollama

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Délai d'une réponse en secondes (sans carte graphique, un modèle local est lent)
OLLAMA_TIMEOUT=600
OLLAMA_NUM_CTX=8192

# ── Claude ───────────────────────────────────────────────────────────────────
# Clé fournie par le serveur ; sinon, chaque utilisateur la saisit dans l'interface.
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (défaut), claude-opus-5-5 ou claude-haiku-5-5
DATAMIND_CLAUDE_MODEL=claude-sonnet-5-5

# ── Garde-fous ───────────────────────────────────────────────────────────────
# Allers-retours maximum entre le modèle et l'exécution de code, par question
DATAMIND_MAX_STEPS=12
# Durée maximale d'une exécution de code, en secondes
DATAMIND_EXEC_TIMEOUT=120

# Libellé affiché sous le nom de l'app (ex. « Suite Atelier »)
DATAMIND_INSTANCE_LABEL=
