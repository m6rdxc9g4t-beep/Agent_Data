# Toutes les variables sont facultatives.

# Serveur
HOST=127.0.0.1
PORT=3600
# Dossier des jeux de données et des analyses
DATA_DIR=./data
# Interface compilée (frontend/dist) servie par le backend en production
# STATIC_DIR=./frontend/dist
MAX_UPLOAD_MB=200

# Moteur affiché par défaut : ollama ou claude (vide = claude si le forfait est configuré, sinon ollama)
DATAMIND_ENGINE=

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=600
OLLAMA_NUM_CTX=8192

# Claude avec ton forfait (Pro / Max), sans clé API, pour un usage personnel :
# lance « claude setup-token » sur une machine avec navigateur et colle le jeton ici.
# S'il est renseigné, il est utilisé en priorité et Claude devient le moteur par défaut.
CLAUDE_CODE_OAUTH_TOKEN=

# Claude avec une clé API : clé fournie par le serveur (sinon chaque personne la saisit dans l'interface, pour sa session)
ANTHROPIC_API_KEY=
DATAMIND_CLAUDE_MODEL=claude-sonnet-5-5

# Garde-fous
DATAMIND_MAX_STEPS=12
DATAMIND_QUERY_TIMEOUT=60

# Libellé sous le nom de l'app (ex. « Suite Atelier »)
DATAMIND_INSTANCE_LABEL=

# Démo publique (voir le README) : jeux d'exemple seulement, aucune écriture, Ollama seul, Claude coupé.
# DATAMIND_DEMO=1
# DATAMIND_DEMO_QUESTIONS_PAR_HEURE=10
# DATAMIND_DEMO_RETOUR=https://portfolio.example.fr/
