# Toutes les variables sont facultatives.

# Serveur
HOST=127.0.0.1
PORT=3600
# Dossier des jeux de données et des analyses
DATA_DIR=./data
# Interface compilée (frontend/dist) servie par le backend en production
# STATIC_DIR=./frontend/dist
MAX_UPLOAD_MB=200

# Moteur affiché par défaut : ollama (local, gratuit) ou claude (API Anthropic)
DATAMIND_ENGINE=ollama

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=600
OLLAMA_NUM_CTX=8192

# Claude : clé fournie par le serveur (sinon chaque personne la saisit dans l'interface, pour sa session)
ANTHROPIC_API_KEY=
DATAMIND_CLAUDE_MODEL=claude-sonnet-5-5

# Garde-fous
DATAMIND_MAX_STEPS=12
DATAMIND_QUERY_TIMEOUT=60

# Libellé sous le nom de l'app (ex. « Suite Atelier »)
DATAMIND_INSTANCE_LABEL=
